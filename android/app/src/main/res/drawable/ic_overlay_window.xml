<?xml version="1.0" encoding="utf-8"?>
<!--
  A filled card overlapping an outlined window — a literal picture of what the permission
  does, rather than a generic bell or shield. Carries no colour of its own; tinted at the
  call site so it inherits the prompt's accent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The app underneath: outlined, receding. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:pathData="M5,4 h10 a2,2 0 0 1 2,2 v7 a2,2 0 0 1 -2,2 h-10 a2,2 0 0 1 -2,-2 v-7 a2,2 0 0 1 2,-2 z" />

    <!-- The briefing card on top: filled, dominant. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,11.5 h7 a2,2 0 0 1 2,2 v4.5 a2,2 0 0 1 -2,2 h-7 a2,2 0 0 1 -2,-2 v-4.5 a2,2 0 0 1 2,-2 z" />
</vector>
