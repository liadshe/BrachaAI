# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# OpenAI API key used by backend/src/services/aiService.ts
API=sk-proj-...

# Secret used to sign and verify JWTs. Must be set — the backend refuses to
# start without it. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value invalidates every issued token; users must log in again.
JWT_SECRET=
